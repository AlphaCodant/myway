# Copier ce fichier en .env et adapter les valeurs
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://livraison:livraison@localhost:5432/livraison
# Laisser à false : le schéma est créé par les migrations (npm run migration:run)
DB_SYNC=false
JWT_SECRET=change-moi-en-production
JWT_EXPIRES_IN=30d
# En développement, le code OTP est renvoyé dans la réponse et affiché dans les logs
OTP_DEV_MODE=true
# Fournisseur SMS : console (développement) ou un fournisseur réel à brancher
SMS_PROVIDER=console
# Agrégateur de paiement : simulated (développement) ou cinetpay
PAYMENT_PROVIDER=simulated
PAYMENT_WEBHOOK_SECRET=change-moi
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
